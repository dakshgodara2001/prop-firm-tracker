# Copy to `.env` on the server (it is gitignored). docker compose reads it.

# Domain(s) Caddy should serve and get HTTPS certs for. Both apex and www.
SITE_ADDRESS=propfirmsdealz.com, www.propfirmsdealz.com

# Email for Let's Encrypt (expiry notices / recovery).
ACME_EMAIL=godaradaksh2001@gmail.com

# When the daily pipeline runs inside the scheduler container (IST, 24h).
PFT_RUN_AT=19:30

# --- Optional: password-protect the dashboard ---
# Uncomment the basicauth block in deploy/Caddyfile, then set these.
# Generate the hash: docker compose run --rm caddy caddy hash-password --plaintext 'yourpass'
# BASIC_AUTH_USER=daksh
# BASIC_AUTH_HASH=$2a$14$...
