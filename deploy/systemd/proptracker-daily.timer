# Weekdays at 19:30 IST (exchanges publish bulk/block deals ~18:30 IST).
#   sudo cp deploy/systemd/proptracker-daily.{service,timer} /etc/systemd/system/
#   sudo systemctl enable --now proptracker-daily.timer
[Unit]
Description=Run the prop-firm deal pipeline every weekday evening (IST)

[Timer]
OnCalendar=Mon..Fri 19:30 Asia/Kolkata
Persistent=true

[Install]
WantedBy=timers.target
